<Window x:Class="PhaseDrop.App.UI.Tools.CropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phase Drop — Crop Image"
        Width="920" Height="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimary}"
        Foreground="{DynamicResource TextPrimary}"
        Icon="/Assets/icon.ico">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header / Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <TextBlock x:Name="FileTitleText"
                           Text="photo.png"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock x:Name="DimensionInfoText"
                           Text="Original Size: 1920 × 1080"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <!-- Aspect Ratio Selector -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Aspect Ratio:"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,8,0" />
                
                <ComboBox x:Name="AspectCombo"
                          Width="130"
                          Height="30"
                          SelectionChanged="AspectCombo_SelectionChanged">
                    <ComboBoxItem Content="Free" IsSelected="True" />
                    <ComboBoxItem Content="1:1 (Square)" />
                    <ComboBoxItem Content="4:3 (Standard)" />
                    <ComboBoxItem Content="16:9 (Widescreen)" />
                    <ComboBoxItem Content="3:2 (Classic 35mm)" />
                    <ComboBoxItem Content="9:16 (Story/Reel)" />
                </ComboBox>

                <Button Content="Reset Crop"
                        Padding="10,4"
                        Margin="10,0,0,0"
                        Background="{DynamicResource BgSecondary}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource BorderPrimary}"
                        BorderThickness="1"
                        Click="ResetCrop_Click" />
            </StackPanel>
        </Grid>

        <!-- Preview Canvas with Draggable Handles -->
        <Border Grid.Row="1"
                Background="#181A20"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <Canvas x:Name="CropCanvas"
                    ClipToBounds="True"
                    SizeChanged="CropCanvas_SizeChanged"
                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                    MouseMove="Canvas_MouseMove"
                    MouseLeftButtonUp="Canvas_MouseLeftButtonUp">
                
                <!-- Loaded Image -->
                <Image x:Name="PreviewImage"
                       Stretch="Uniform" />

                <!-- Shaded Dim Overlay Outside Crop Area -->
                <Path x:Name="ShadeOverlay"
                      Fill="#99000000" />

                <!-- Crop Frame Rectangle -->
                <Rectangle x:Name="CropRect"
                           Stroke="{DynamicResource AccentPrimary}"
                           StrokeThickness="2"
                           StrokeDashArray="4 2" />

                <!-- Corner Handles -->
                <Ellipse x:Name="HandleNW" Width="14" Height="14" Fill="White" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="2" Tag="NW" Cursor="SizeNWSE" />
                <Ellipse x:Name="HandleNE" Width="14" Height="14" Fill="White" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="2" Tag="NE" Cursor="SizeNESW" />
                <Ellipse x:Name="HandleSW" Width="14" Height="14" Fill="White" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="2" Tag="SW" Cursor="SizeNESW" />
                <Ellipse x:Name="HandleSE" Width="14" Height="14" Fill="White" Stroke="{DynamicResource AccentPrimary}" StrokeThickness="2" Tag="SE" Cursor="SizeNWSE" />
            </Canvas>
        </Border>

        <!-- Footer / Action Buttons -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="CropSizeStatusText"
                       Text="Crop Output: 1920 × 1080"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondary}"
                       VerticalAlignment="Center" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Padding="16,6"
                        Margin="0,0,10,0"
                        Background="{DynamicResource BgSecondary}"
                        Foreground="{DynamicResource TextPrimary}"
                        BorderBrush="{DynamicResource BorderPrimary}"
                        BorderThickness="1"
                        Click="Cancel_Click" />

                <Button Content="Apply &amp; Crop"
                        Padding="18,6"
                        Background="{DynamicResource AccentPrimary}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Click="ApplyCrop_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
