<Window x:Class="PhaseDrop.App.UI.Tools.ResizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phase Drop — Resize Image"
        Width="460" Height="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimary}"
        Foreground="{DynamicResource TextPrimary}"
        Icon="/Assets/icon.ico"
        ResizeMode="NoResize">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="FileNameText"
                       Text="image.png"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}" />
            <TextBlock x:Name="OriginalSizeText"
                       Text="Original: 1920 × 1080 px"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,2,0,0" />
        </StackPanel>

        <!-- Content Settings -->
        <StackPanel Grid.Row="1" Orientation="Vertical">
            <!-- Percentage Presets -->
            <TextBlock Text="Scale Percentage"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,6" />
            
            <UniformGrid Columns="5" Margin="0,0,0,16">
                <Button Content="25%" Margin="0,0,4,0" Padding="0,5" Background="{DynamicResource BgSecondary}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderPrimary}" Click="ScalePreset_Click" Tag="25" />
                <Button Content="50%" Margin="0,0,4,0" Padding="0,5" Background="{DynamicResource BgSecondary}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderPrimary}" Click="ScalePreset_Click" Tag="50" />
                <Button Content="75%" Margin="0,0,4,0" Padding="0,5" Background="{DynamicResource BgSecondary}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderPrimary}" Click="ScalePreset_Click" Tag="75" />
                <Button Content="150%" Margin="0,0,4,0" Padding="0,5" Background="{DynamicResource BgSecondary}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderPrimary}" Click="ScalePreset_Click" Tag="150" />
                <Button Content="200%" Padding="0,5" Background="{DynamicResource BgSecondary}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderPrimary}" Click="ScalePreset_Click" Tag="200" />
            </UniformGrid>

            <!-- Dimensions -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Width (px)" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox x:Name="WidthBox"
                             Height="32"
                             FontSize="13"
                             Padding="6,4"
                             Background="{DynamicResource BgSecondary}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource BorderPrimary}"
                             TextChanged="WidthBox_TextChanged" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="×" FontSize="18" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,14,0,0" />

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Height (px)" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox x:Name="HeightBox"
                             Height="32"
                             FontSize="13"
                             Padding="6,4"
                             Background="{DynamicResource BgSecondary}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource BorderPrimary}"
                             TextChanged="HeightBox_TextChanged" />
                </StackPanel>
            </Grid>

            <!-- Keep Aspect Ratio -->
            <CheckBox x:Name="KeepAspectCheck"
                      Content="Maintain aspect ratio"
                      IsChecked="True"
                      FontSize="12"
                      Foreground="{DynamicResource TextPrimary}"
                      Margin="0,0,0,16" />

            <!-- Output Format -->
            <TextBlock Text="Output Format" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" />
            <ComboBox x:Name="FormatCombo" Height="32" Margin="0,0,0,16">
                <ComboBoxItem Content="Keep Original Extension" IsSelected="True" />
                <ComboBoxItem Content="PNG (Lossless)" />
                <ComboBoxItem Content="JPEG (Photo)" />
                <ComboBoxItem Content="WebP (Modern)" />
            </ComboBox>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel"
                    Padding="16,6"
                    Margin="0,0,10,0"
                    Background="{DynamicResource BgSecondary}"
                    Foreground="{DynamicResource TextPrimary}"
                    BorderBrush="{DynamicResource BorderPrimary}"
                    BorderThickness="1"
                    Click="Cancel_Click" />

            <Button Content="Apply &amp; Resize"
                    Padding="18,6"
                    Background="{DynamicResource AccentPrimary}"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Click="Apply_Click" />
        </StackPanel>
    </Grid>
</Window>
