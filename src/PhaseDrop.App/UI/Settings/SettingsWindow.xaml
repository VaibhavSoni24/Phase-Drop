<Window x:Class="PhaseDrop.App.UI.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phase Drop — Settings"
        Width="620" Height="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimary}"
        Foreground="{DynamicResource TextPrimary}"
        Icon="/Assets/icon.ico"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image Source="/Assets/icon.ico" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Phase Drop Settings" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="Drop. Transform. Done. — Completely local file utility" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
        </Grid>

        <!-- Tabbed or Grouped Settings ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">
                <!-- Theme Section -->
                <TextBlock Text="Appearance &amp; Theme" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,8" />
                <Border Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Application Theme" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                        <TextBlock Text="Choose between Windows system preference, light, or dark palette." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" />
                        
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ThemeSystemRadio" Content="System Default" Margin="0,0,18,0" Foreground="{DynamicResource TextPrimary}" Checked="ThemeRadio_Checked" />
                            <RadioButton x:Name="ThemeDarkRadio" Content="Dark Theme" Margin="0,0,18,0" Foreground="{DynamicResource TextPrimary}" Checked="ThemeRadio_Checked" />
                            <RadioButton x:Name="ThemeLightRadio" Content="Light Theme" Foreground="{DynamicResource TextPrimary}" Checked="ThemeRadio_Checked" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Output Folder Section -->
                <TextBlock Text="Output Location" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,8" />
                <Border Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,18">
                    <StackPanel>
                        <RadioButton x:Name="OutputSourceFolderRadio" Content="Same folder as source file (Collision-safe: 'file (1).ext')" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" Checked="OutputLocation_Checked" />
                        <RadioButton x:Name="OutputCustomFolderRadio" Content="Dedicated output folder" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" Checked="OutputLocation_Checked" />

                        <Grid Margin="24,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="CustomFolderBox" Height="30" FontSize="12" Padding="6,4" Background="{DynamicResource BgSecondary}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderPrimary}" IsReadOnly="True" />
                            <Button x:Name="BrowseFolderBtn" Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Padding="12,4" Background="{DynamicResource BgSecondary}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderPrimary}" Click="BrowseFolder_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Processing & Performance Section -->
                <TextBlock Text="Processing &amp; Background Lifecycle" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,8" />
                <Border Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,18">
                    <StackPanel>
                        <!-- Concurrency -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Maximum Concurrent Jobs" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Parallel conversion task concurrency limit." FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                            <TextBlock x:Name="ConcurrencyValueText" Grid.Column="1" Text="4" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentPrimary}" VerticalAlignment="Center" />
                        </Grid>
                        <Slider x:Name="ConcurrencySlider" Minimum="1" Maximum="8" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,16" ValueChanged="ConcurrencySlider_ValueChanged" />

                        <!-- Start with Windows -->
                        <CheckBox x:Name="StartupCheck" Content="Start Phase Drop automatically when logging into Windows" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" Click="StartupCheck_Click" />

                        <!-- Notifications -->
                        <CheckBox x:Name="NotifyCheck" Content="Show floating progress card during conversions" IsChecked="True" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />

                        <!-- Drag Distance Threshold -->
                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Drag Movement Sensitivity Threshold" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock x:Name="DragThresholdText" Grid.Column="1" Text="4 px" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                        </Grid>
                        <Slider x:Name="DragThresholdSlider" Minimum="2" Maximum="16" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="DragThresholdSlider_ValueChanged" />
                    </StackPanel>
                </Border>

                <!-- Privacy & About Section -->
                <TextBlock Text="About &amp; Privacy" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentPrimary}" Margin="0,0,0,8" />
                <Border Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="100% Offline &amp; Local. No telemetry. No advertising. No cloud dependency." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12" />

                        <WrapPanel>
                            <Button Content="Open Logs Folder" Margin="0,0,8,8" Padding="12,5" Background="{DynamicResource BgSecondary}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderPrimary}" Click="OpenLogs_Click" />
                            <Button Content="Open Output Folder" Margin="0,0,8,8" Padding="12,5" Background="{DynamicResource BgSecondary}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderPrimary}" Click="OpenOutput_Click" />
                            <Button Content="Reset to Defaults" Margin="0,0,8,8" Padding="12,5" Background="{DynamicResource BgSecondary}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderPrimary}" Click="ResetDefaults_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="Phase Drop v1.0.0 LTS • GPL-3.0 License" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />

            <Button Content="Save &amp; Close"
                    Padding="18,6"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource AccentPrimary}"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Click="SaveClose_Click" />
        </Grid>
    </Grid>
</Window>
